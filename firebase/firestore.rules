rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function roleOf(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }
    function isAdmin() { return signedIn() && roleOf(request.auth.uid) == 'admin'; }

    // An image uploaded to Cloudinary (ImageRef): exactly a secure URL on
    // res.cloudinary.com and its public id. The bytes live on Cloudinary;
    // Firestore only keeps the reference.
    function validImage(image) {
      return image is map
        && image.keys().hasOnly(['url', 'publicId'])
        && image.keys().hasAll(['url', 'publicId'])
        && image.url is string && image.url.size() <= 500
        && image.url.matches('https://res[.]cloudinary[.]com/.+')
        && image.publicId is string && image.publicId.size() >= 1 && image.publicId.size() <= 200;
    }

    // A valid note: known type and mood, title 1-120 chars, journal <= 2000
    // chars (handout limits, deviation D-02).
    function validNote(note) {
      return note.keys().hasAll(['type', 'title', 'createdAt'])
        && note.keys().hasOnly(['type', 'title', 'body', 'mood', 'createdAt',
                                'challengeId', 'subtype', 'outcome', 'anxietyBefore', 'anxietyAfter', 'minutes',
                                'groupId', 'isFirst', 'image'])
        && note.type in ['chien_thang', 'tu_chu', 'thu_thach', 'nhat_ky']
        && note.title is string && note.title.size() >= 1 && note.title.size() <= 120
        && (!('body' in note) || (note.body is string && note.body.size() <= 2000))
        && (!('mood' in note) || note.mood in ['vui', 'on', 'binh_thuong', 'met', 'roi'])
        && note.createdAt is timestamp
        && (!('subtype' in note) || note.subtype in ['nguoi_la', 'van_dong'])
        && (!('outcome' in note) || note.outcome in ['suon_se', 'khong_nhu_y'])
        && (!('anxietyBefore' in note) || (note.anxietyBefore is int && note.anxietyBefore >= 1 && note.anxietyBefore <= 5))
        && (!('anxietyAfter' in note) || (note.anxietyAfter is int && note.anxietyAfter >= 1 && note.anxietyAfter <= 5))
        && (!('minutes' in note) || (note.minutes is int && note.minutes >= 0 && note.minutes <= 600))
        && (!('groupId' in note) || (note.groupId is string && note.groupId.size() >= 1 && note.groupId.size() <= 64))
        && (!('isFirst' in note) || note.isFirst is bool)
        && (!('image' in note) || validImage(note.image));
    }

    // A "first time" group: name 1-24 chars, one of Not's five ideas, a
    // non-negative note count (Figma `Spec · Nhóm lần đầu`).
    function validGroup(group) {
      return group.keys().hasAll(['name', 'idea', 'source', 'noteCount'])
        && group.keys().hasOnly(['name', 'idea', 'source', 'noteCount', 'firstNoteId',
                                 'firstNoteTitle', 'firstAt', 'lastAt', 'createdAt', 'image'])
        && group.name is string && group.name.size() >= 1 && group.name.size() <= 24
        && group.idea in ['chien_thang', 'nhat_ky', 'tu_chu', 'nguoi_la', 'van_dong']
        && group.source in ['system', 'user', 'ai_suggested']
        && group.noteCount is int && group.noteCount >= 0
        && (!('firstNoteTitle' in group) || (group.firstNoteTitle is string && group.firstNoteTitle.size() <= 120))
        && (!('image' in group) || validImage(group.image));
    }

    // Challenge catalog: read-only for signed-in users; staff manage it from
    // the admin web (Final Assignment) or the seed script.
    match /challenges/{id} {
      allow read: if signedIn();
    }

    // Deny by default: only the matches below are reachable.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == 'user'
                    && (!('photo' in request.resource.data) || validImage(request.resource.data.photo));
      // Admin changes the role; the owner changes only their profile photo
      // (set or removed), never the role.
      allow update: if (isAdmin()
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']))
                    || (isOwner(uid)
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photo'])
                       && (!('photo' in request.resource.data) || validImage(request.resource.data.photo)));

      match /notes/{noteId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validNote(request.resource.data);
      }

      // Self-control habits and settings: private to the owner, small docs.
      match /private/habits {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
                              && request.resource.data.keys().hasOnly(['selected', 'custom'])
                              && (!('selected' in request.resource.data) || request.resource.data.selected.size() <= 20)
                              && (!('custom' in request.resource.data) || request.resource.data.custom.size() <= 8);
      }
      match /private/settings {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
                              && request.resource.data.keys().hasOnly(['eveningReminder', 'awakeEnabled', 'awakeStart', 'awakeEnd',
                                                                  'lockSelfControl', 'aiEnabled', 'hideNotificationContent']);
      }

      match /challengeProgress/{topic} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
                              && topic in ['dung_cam', 'van_dong']
                              && request.resource.data.keys().hasOnly(['level', 'completed'])
                              && request.resource.data.level is int
                              && request.resource.data.level >= 1;
      }

      // Cards the user adds for themselves ("one small good deed a day").
      // Created and deleted, never edited; private to the owner.
      match /customChallenges/{id} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
                      && request.resource.data.keys().hasAll(['topic', 'title', 'minutes', 'createdAt'])
                      && request.resource.data.keys().hasOnly(['topic', 'title', 'minutes', 'tip', 'createdAt'])
                      && request.resource.data.topic in ['dung_cam', 'van_dong']
                      && request.resource.data.title is string
                      && request.resource.data.title.size() >= 1
                      && request.resource.data.title.size() <= 80
                      && request.resource.data.minutes is int
                      && request.resource.data.minutes >= 1
                      && request.resource.data.minutes <= 600
                      && (!('tip' in request.resource.data)
                          || (request.resource.data.tip is string && request.resource.data.tip.size() <= 120))
                      && request.resource.data.createdAt is timestamp;
      }

      match /groups/{groupId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validGroup(request.resource.data);
      }

      // Streak share cards: a base64 PNG (<= 850k chars, see
      // StreakShareLimits) plus the numbers it shows. Created by the owner,
      // never edited.
      match /sharedStreaks/{id} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
                      && request.resource.data.keys().hasOnly(['image', 'streak', 'record', 'milestone', 'createdAt'])
                      && request.resource.data.keys().hasAll(['image', 'streak', 'record', 'milestone', 'createdAt'])
                      && request.resource.data.image is string
                      && request.resource.data.image.size() <= 850000
                      && request.resource.data.streak is int
                      && request.resource.data.record is int
                      && request.resource.data.milestone is int
                      && request.resource.data.createdAt is timestamp;
      }

      match /stickers/{month} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
                              && request.resource.data.keys().hasOnly(['month', 'createdAt'])
                              && request.resource.data.month == month;
      }

      // 1-to-1 Discord account association for this Nốt user.
      match /private/discord {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
                      && request.resource.data.keys().hasAll(['discordId', 'discordUsername', 'linkedAt'])
                      && request.resource.data.keys().hasOnly(['discordId', 'discordUsername', 'linkedAt'])
                      && request.resource.data.discordId is string
                      && request.resource.data.discordId.size() >= 1
                      && request.resource.data.discordId.size() <= 64
                      && request.resource.data.discordUsername is string
                      && request.resource.data.discordUsername.size() >= 1
                      && request.resource.data.discordUsername.size() <= 100
                      && request.resource.data.linkedAt is timestamp;
      }
    }

    // One-time connection codes generated by the DM-only Discord bot (`connect` command).
    match /discordConnectCodes/{code} {
      allow get: if signedIn();
      allow create, update: if code.size() == 6
                            && request.resource.data.keys().hasAll(['discordId', 'discordUsername', 'createdAt', 'expiresAt'])
                            && request.resource.data.keys().hasOnly(['discordId', 'discordUsername', 'createdAt', 'expiresAt'])
                            && request.resource.data.discordId is string
                            && request.resource.data.discordId.size() >= 1
                            && request.resource.data.discordId.size() <= 64
                            && request.resource.data.discordUsername is string
                            && request.resource.data.discordUsername.size() >= 1
                            && request.resource.data.discordUsername.size() <= 100
                            && request.resource.data.createdAt is timestamp
                            && request.resource.data.expiresAt is timestamp;
      allow delete: if signedIn();
    }

    // Global 1-to-1 mapping from Discord ID -> Nốt user UID (prevents 1 Discord account linking to multiple Nốt accounts).
    match /discordLinks/{discordId} {
      allow get: if true;
      allow create: if signedIn()
                    && request.resource.data.keys().hasAll(['uid', 'discordUsername', 'linkedAt'])
                    && request.resource.data.keys().hasOnly(['uid', 'discordUsername', 'linkedAt'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.discordUsername is string
                    && request.resource.data.discordUsername.size() >= 1
                    && request.resource.data.discordUsername.size() <= 100
                    && request.resource.data.linkedAt is timestamp;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
