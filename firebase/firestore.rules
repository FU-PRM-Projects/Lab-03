rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function roleOf(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }
    function isAdmin() { return signedIn() && roleOf(request.auth.uid) == 'admin'; }
    // Staff work on the web admin; an admin has every staff right too.
    function isStaff() { return signedIn() && roleOf(request.auth.uid) in ['staff', 'admin']; }
    function isTopic(topic) { return topic in ['dung_cam', 'van_dong']; }
    function shortText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    // An image uploaded to Cloudinary (ImageRef): exactly a secure URL on
    // res.cloudinary.com and its public id. The bytes live on Cloudinary;
    // Firestore only keeps the reference.
    function validImage(image) {
      return image is map
        && image.keys().hasOnly(['url', 'publicId'])
        && image.keys().hasAll(['url', 'publicId'])
        && image.url is string && image.url.size() <= 500
        && image.url.matches('https://res[.]cloudinary[.]com/.+')
        && image.publicId is string && image.publicId.size() >= 1 && image.publicId.size() <= 200;
    }

    // A valid note: known type and mood, title 1-120 chars, journal <= 2000
    // chars (handout limits, deviation D-02).
    function validNote(note) {
      return note.keys().hasAll(['type', 'title', 'createdAt'])
        && note.keys().hasOnly(['type', 'title', 'body', 'mood', 'createdAt',
                                'challengeId', 'subtype', 'outcome', 'anxietyBefore', 'anxietyAfter', 'minutes',
                                'groupId', 'isFirst', 'image'])
        && note.type in ['chien_thang', 'tu_chu', 'thu_thach', 'nhat_ky']
        && note.title is string && note.title.size() >= 1 && note.title.size() <= 120
        && (!('body' in note) || (note.body is string && note.body.size() <= 2000))
        && (!('mood' in note) || note.mood in ['vui', 'on', 'binh_thuong', 'met', 'roi'])
        && note.createdAt is timestamp
        && (!('subtype' in note) || note.subtype in ['nguoi_la', 'van_dong'])
        && (!('outcome' in note) || note.outcome in ['suon_se', 'khong_nhu_y'])
        && (!('anxietyBefore' in note) || (note.anxietyBefore is int && note.anxietyBefore >= 1 && note.anxietyBefore <= 5))
        && (!('anxietyAfter' in note) || (note.anxietyAfter is int && note.anxietyAfter >= 1 && note.anxietyAfter <= 5))
        && (!('minutes' in note) || (note.minutes is int && note.minutes >= 0 && note.minutes <= 600))
        && (!('groupId' in note) || (note.groupId is string && note.groupId.size() >= 1 && note.groupId.size() <= 64))
        && (!('isFirst' in note) || note.isFirst is bool)
        && (!('image' in note) || validImage(note.image));
    }

    // A "first time" group: name 1-24 chars, one of Not's five ideas, a
    // non-negative note count (Figma `Spec · Nhóm lần đầu`).
    function validGroup(group) {
      return group.keys().hasAll(['name', 'idea', 'source', 'noteCount'])
        && group.keys().hasOnly(['name', 'idea', 'source', 'noteCount', 'firstNoteId',
                                 'firstNoteTitle', 'firstAt', 'lastAt', 'createdAt', 'image'])
        && group.name is string && group.name.size() >= 1 && group.name.size() <= 24
        && group.idea in ['chien_thang', 'nhat_ky', 'tu_chu', 'nguoi_la', 'van_dong']
        && group.source in ['system', 'user', 'ai_suggested']
        && group.noteCount is int && group.noteCount >= 0
        && (!('firstNoteTitle' in group) || (group.firstNoteTitle is string && group.firstNoteTitle.size() <= 120))
        && (!('image' in group) || validImage(group.image));
    }

    // A catalog card. `status` archived hides it in the app; cards are never
    // deleted so notes that point at them keep working.
    function validChallenge(card) {
      return card.keys().hasAll(['topic', 'level', 'order', 'title', 'minutes', 'status', 'updatedBy', 'updatedAt'])
        && card.keys().hasOnly(['topic', 'level', 'order', 'title', 'minutes', 'tip', 'script',
                                'discordRoom', 'status', 'source', 'submissionId', 'updatedAt', 'updatedBy'])
        && isTopic(card.topic)
        && card.level is int && card.level >= 1 && card.level <= 10
        && card.order is int && card.order >= 0 && card.order <= 999
        && shortText(card.title, 1, 80)
        && card.minutes is int && card.minutes >= 1 && card.minutes <= 600
        && (!('tip' in card) || shortText(card.tip, 0, 120))
        && (!('script' in card) || shortText(card.script, 0, 300))
        && (!('discordRoom' in card) || shortText(card.discordRoom, 1, 40))
        && card.status in ['active', 'archived']
        && (!('source' in card) || card.source in ['seed', 'staff', 'community'])
        && (!('submissionId' in card) || shortText(card.submissionId, 1, 64))
        // Every staff write stamps who changed the card and when.
        && card.updatedBy == request.auth.uid
        && card.updatedAt == request.time;
    }

    // Challenge catalog: every signed-in user reads it; staff manage it on the
    // web admin (archive instead of delete).
    match /challenges/{id} {
      allow read: if signedIn();
      allow create, update: if isStaff() && validChallenge(request.resource.data);
    }

    // Cards users suggest for the shared catalog (cross-role flow): the user
    // submits it as pending, staff approve or reject it with a reason.
    match /challengeSubmissions/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isStaff());
      allow create: if signedIn()
                    && request.resource.data.keys().hasAll(['uid', 'topic', 'title', 'minutes', 'status', 'createdAt'])
                    && request.resource.data.keys().hasOnly(['uid', 'topic', 'title', 'minutes', 'tip', 'customId', 'status', 'createdAt'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && isTopic(request.resource.data.topic)
                    && shortText(request.resource.data.title, 1, 80)
                    && request.resource.data.minutes is int
                    && request.resource.data.minutes >= 1 && request.resource.data.minutes <= 600
                    && (!('tip' in request.resource.data) || shortText(request.resource.data.tip, 0, 120))
                    && (!('customId' in request.resource.data) || shortText(request.resource.data.customId, 1, 64))
                    && request.resource.data.createdAt == request.time;
      // Only pending -> approved | rejected; a rejection needs a reason.
      allow update: if isStaff()
                    && resource.data.status == 'pending'
                    && request.resource.data.status in ['approved', 'rejected']
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'reason', 'reviewedAt', 'reviewedBy', 'challengeId'])
                    && request.resource.data.reviewedBy == request.auth.uid
                    && request.resource.data.reviewedAt == request.time
                    && shortText(request.resource.data.get('reason', ''), 0, 200)
                    && (request.resource.data.status == 'approved'
                        || request.resource.data.get('reason', '').size() >= 1);
      allow delete: if signedIn()
                    && resource.data.uid == request.auth.uid
                    && resource.data.status == 'pending';
    }

    // Announcements from the web admin; every signed-in user reads them in
    // the app inbox.
    match /announcements/{id} {
      allow read: if signedIn();
      allow create: if isStaff()
                    && request.resource.data.keys().hasOnly(['title', 'body', 'authorUid', 'createdAt'])
                    && request.resource.data.keys().hasAll(['title', 'body', 'authorUid', 'createdAt'])
                    && shortText(request.resource.data.title, 1, 80)
                    && shortText(request.resource.data.body, 1, 1000)
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.createdAt == request.time;
      allow delete: if isStaff();
    }

    // Deny by default: only the matches below are reachable.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == 'user'
                    && (!('photo' in request.resource.data) || validImage(request.resource.data.photo));
      // Admin changes someone else's role; the owner changes only their
      // profile photo (set or removed), never the role.
      allow update: if (isAdmin()
                       && request.auth.uid != uid
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
                       && request.resource.data.role in ['user', 'staff', 'admin'])
                    || (isOwner(uid)
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photo'])
                       && (!('photo' in request.resource.data) || validImage(request.resource.data.photo)));

      match /notes/{noteId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validNote(request.resource.data);
      }

      // Self-control habits and settings: private to the owner, small docs.
      match /private/habits {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
                              && request.resource.data.keys().hasOnly(['selected', 'custom'])
                              && (!('selected' in request.resource.data) || request.resource.data.selected.size() <= 20)
                              && (!('custom' in request.resource.data) || request.resource.data.custom.size() <= 8);
      }
      match /private/settings {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
                              && request.resource.data.keys().hasOnly(['eveningReminder', 'awakeEnabled', 'awakeStart', 'awakeEnd',
                                                                  'lockSelfControl', 'aiEnabled', 'hideNotificationContent']);
      }
      // Câu trả lời làm quen (A2): chỉ chủ tài khoản, giá trị trong danh sách
      // của app; không có tên, email hay nội dung nốt.
      match /private/onboarding {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
                              && request.resource.data.keys().hasOnly(['strangerLevel', 'habits', 'move', 'freeSlot', 'goals',
                                                                  'profileLabel', 'planSource', 'done', 'completedAt'])
                              && request.resource.data.done == true
                              && (request.resource.data.get('strangerLevel', null) == null
                                  || (request.resource.data.strangerLevel is int
                                      && request.resource.data.strangerLevel >= 1
                                      && request.resource.data.strangerLevel <= 4))
                              && request.resource.data.get('habits', []) is list
                              && request.resource.data.get('habits', []).size() <= 20
                              && request.resource.data.get('move', null) in [null, 'it_khi', 'thinh_thoang', 'thuong_xuyen']
                              && request.resource.data.get('freeSlot', null) in [null, 'sang', 'chieu', 'toi', 'khuya']
                              && request.resource.data.get('goals', []) is list
                              && request.resource.data.get('goals', []).size() <= 2
                              && (request.resource.data.get('profileLabel', '') is string
                                  && request.resource.data.get('profileLabel', '').size() <= 30)
                              && request.resource.data.get('planSource', 'rules') in ['ai', 'rules']
                              && request.resource.data.completedAt == request.time;
      }

      match /challengeProgress/{topic} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
                              && topic in ['dung_cam', 'van_dong']
                              && request.resource.data.keys().hasOnly(['level', 'completed'])
                              && request.resource.data.level is int
                              && request.resource.data.level >= 1;
      }

      // Cards the user adds for themselves ("one small good deed a day").
      // Created and deleted, never edited; private to the owner.
      match /customChallenges/{id} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
                      && request.resource.data.keys().hasAll(['topic', 'title', 'minutes', 'createdAt'])
                      && request.resource.data.keys().hasOnly(['topic', 'title', 'minutes', 'tip', 'createdAt'])
                      && request.resource.data.topic in ['dung_cam', 'van_dong']
                      && request.resource.data.title is string
                      && request.resource.data.title.size() >= 1
                      && request.resource.data.title.size() <= 80
                      && request.resource.data.minutes is int
                      && request.resource.data.minutes >= 1
                      && request.resource.data.minutes <= 600
                      && (!('tip' in request.resource.data)
                          || (request.resource.data.tip is string && request.resource.data.tip.size() <= 120))
                      && request.resource.data.createdAt is timestamp;
      }

      // Personal inbox: staff write a message when they review a submission;
      // the owner reads it, marks it read and deletes it.
      match /inbox/{messageId} {
        allow read, delete: if isOwner(uid);
        allow create: if isStaff()
                      && request.resource.data.keys().hasOnly(['kind', 'title', 'body', 'submissionId', 'read', 'createdAt'])
                      && request.resource.data.keys().hasAll(['kind', 'title', 'body', 'read', 'createdAt'])
                      && request.resource.data.kind in ['submission_approved', 'submission_rejected']
                      && shortText(request.resource.data.title, 1, 80)
                      && shortText(request.resource.data.body, 1, 500)
                      && (!('submissionId' in request.resource.data) || shortText(request.resource.data.submissionId, 1, 64))
                      && request.resource.data.read == false
                      && request.resource.data.createdAt == request.time;
        allow update: if isOwner(uid)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
                      && request.resource.data.read is bool;
      }

      match /groups/{groupId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validGroup(request.resource.data);
      }

      // Streak share cards: a base64 PNG (<= 850k chars, see
      // StreakShareLimits) plus the numbers it shows. Created by the owner,
      // never edited.
      match /sharedStreaks/{id} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
                      && request.resource.data.keys().hasOnly(['image', 'streak', 'record', 'milestone', 'createdAt'])
                      && request.resource.data.keys().hasAll(['image', 'streak', 'record', 'milestone', 'createdAt'])
                      && request.resource.data.image is string
                      && request.resource.data.image.size() <= 850000
                      && request.resource.data.streak is int
                      && request.resource.data.record is int
                      && request.resource.data.milestone is int
                      && request.resource.data.createdAt is timestamp;
      }

      match /stickers/{month} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
                              && request.resource.data.keys().hasOnly(['month', 'createdAt'])
                              && request.resource.data.month == month;
      }

      // 1-to-1 Discord account association for this Nốt user.
      match /private/discord {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
                      && request.resource.data.keys().hasAll(['discordId', 'discordUsername', 'linkedAt'])
                      && request.resource.data.keys().hasOnly(['discordId', 'discordUsername', 'linkedAt'])
                      && request.resource.data.discordId is string
                      && request.resource.data.discordId.size() >= 1
                      && request.resource.data.discordId.size() <= 64
                      && request.resource.data.discordUsername is string
                      && request.resource.data.discordUsername.size() >= 1
                      && request.resource.data.discordUsername.size() <= 100
                      && request.resource.data.linkedAt is timestamp;
      }
    }

    // One-time connection codes generated by the DM-only Discord bot (`connect` command).
    match /discordConnectCodes/{code} {
      allow get: if signedIn();
      allow create, update: if code.size() == 6
                            && request.resource.data.keys().hasAll(['discordId', 'discordUsername', 'createdAt', 'expiresAt'])
                            && request.resource.data.keys().hasOnly(['discordId', 'discordUsername', 'createdAt', 'expiresAt'])
                            && request.resource.data.discordId is string
                            && request.resource.data.discordId.size() >= 1
                            && request.resource.data.discordId.size() <= 64
                            && request.resource.data.discordUsername is string
                            && request.resource.data.discordUsername.size() >= 1
                            && request.resource.data.discordUsername.size() <= 100
                            && request.resource.data.createdAt is timestamp
                            && request.resource.data.expiresAt is timestamp;
      allow delete: if signedIn();
    }

    // Global 1-to-1 mapping from Discord ID -> Nốt user UID (prevents 1 Discord account linking to multiple Nốt accounts).
    match /discordLinks/{discordId} {
      allow get: if true;
      allow create: if signedIn()
                    && request.resource.data.keys().hasAll(['uid', 'discordUsername', 'linkedAt'])
                    && request.resource.data.keys().hasOnly(['uid', 'discordUsername', 'linkedAt'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.discordUsername is string
                    && request.resource.data.discordUsername.size() >= 1
                    && request.resource.data.discordUsername.size() <= 100
                    && request.resource.data.linkedAt is timestamp;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
