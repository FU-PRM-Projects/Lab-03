{
  "name": "prm393-firebase",
  "private": true,
  "scripts": {
    "emulators": "firebase emulators:start --project demo-prm393",
    "emulators:keep": "firebase emulators:start --project demo-prm393 --import emulator-data --export-on-exit",
    "test:rules": "firebase emulators:exec --project demo-prm393 --only firestore \"node --test tests/firestore.rules.test.js\"",
    "seed:emulator": "cross-env FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 node scripts/seed-challenges.js demo-prm393",
    "seed:demo": "cross-env FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 node scripts/seed-demo.js",
    "seed": "node scripts/seed-challenges.js"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "cross-env": "^7.0.3",
    "firebase": "^11.0.0",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^14.27.0"
  }
}
