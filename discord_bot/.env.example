DISCORD_TOKEN=your_discord_bot_token_here
FIREBASE_PROJECT_ID=prm393-not-lab3
# Optional: set FIREBASE_API_KEY if using production Cloud Firestore
# FIREBASE_API_KEY=AIzaSyBBP1qUkoDEQT9sr04ErMfd1naRH7GmSwM
# Optional: uncomment to connect to local Firebase Emulator
# FIRESTORE_EMULATOR_HOST=localhost:8080

# AI agent (any DM that is not a command). Needs both an OpenRouter key and a Firebase service account.
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017
# Abuse guardrail (decision model via OpenRouter). GUARD_MODEL=off disables it; GUARD_THRESHOLD is 0-1 (default 0.5).
# GUARD_MODEL=perplexity/pplx-decider-v1.2
# GUARD_OFFTOPIC_THRESHOLD=0.6
# Service account key JSON (raw or base64) with Firestore access:
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Welcome DM on install: Developer Portal → General Information → Public Key, then set Webhooks → Events URL to https://<domain>/discord/events
DISCORD_PUBLIC_KEY=
# PORT=8080
